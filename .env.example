# =============================================================================
# Environment variables for the "Apify Lead Scrape → AI Score → GHL" workflow
# -----------------------------------------------------------------------------
# Copy this file to `.env`, fill in your real values, and load it into your
# n8n instance (Settings → Environment Variables, or the host environment).
# NEVER commit the filled-in `.env` file — it is git-ignored on purpose.
# =============================================================================

# --- Apify -------------------------------------------------------------------
# API token from https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Actor task id, e.g. "username~leads-scraper-for-brandon"
APIFY_ACTOR_TASK_ID=your-username~your-actor-task

# --- Google Sheets -----------------------------------------------------------
# Spreadsheet id (the long id in the sheet URL: /spreadsheets/d/<ID>/edit)
BRANDON_GOOGLE_SHEET_ID=your_google_sheet_id

# --- OpenAI ------------------------------------------------------------------
# Configured through n8n credentials (OpenAI API). Kept here for reference.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GoHighLevel (LeadConnector) ---------------------------------------------
# Private Integration Token (Bearer) for the GHL location
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# The GHL sub-account / location id
GHL_LOCATION_ID=your_ghl_location_id
