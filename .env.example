# =============================================================================
# Environment variables for the "Apify Lead Scrape → AI Score → GHL" workflow
# -----------------------------------------------------------------------------
# 1. Copy this file:        cp .env.example .env
# 2. Fill in your values.
# 3. Expose them to n8n (host env vars, or n8n Cloud "Variables").
#
# NEVER commit the filled-in `.env` — it is git-ignored on purpose.
# These are placeholders only; no real credentials live in this repo.
# =============================================================================

# --- Apify -------------------------------------------------------------------
# API token: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Actor task id, e.g. "username~leads-scraper" (used in the run-sync URL)
APIFY_ACTOR_TASK_ID=your-username~your-actor-task

# --- Google Sheets -----------------------------------------------------------
# Spreadsheet id (the long id in the URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id

# --- OpenAI ------------------------------------------------------------------
# Set via n8n credentials (OpenAI API). Listed here for reference.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GoHighLevel (LeadConnector) ---------------------------------------------
# Private Integration Token (Bearer) for the GHL location
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GHL sub-account / location id
GHL_LOCATION_ID=your_ghl_location_id
