    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst originalLeads = $('Read Scraped Leads from Google Sheet').all();\n\nconst fixedQualifiedTags = [\n  'brandon-ai-lead',\n  'brandon-apify',\n  'n8n',\n  'ai-researched',\n  'qualified-lead'\n];\n\nconst fixedReviewTags = [\n  'brandon-ai-lead',\n  'brandon-apify',\n  'n8n',\n  'ai-researched',\n  'review-needed'\n];\n\nfunction cleanEmail(email) {\n  if (!email) return '';\n  return String(email)\n    .split(',')\n    .map(e => e.trim())\n    .filter(Boolean)[0] || '';\n}\n\nfunction extractAI(json) {\n  // Case 1: Direct AI JSON object\n  if (\n    json.services_offered ||\n    json.lead_score ||\n    json.why_fit ||\n    json.suggested_pitch\n  ) {\n    return json;\n  }\n\n  // Case 2: n8n OpenAI \"Message a Model\" output format\n  if (Array.isArray(json.output)) {\n    for (const outputItem of json.output) {\n      if (Array.isArray(outputItem.content)) {\n        for (const contentItem of outputItem.content) {\n          if (contentItem.text) {\n            if (typeof contentItem.text === 'object') {\n              return contentItem.text;\n            }\n\n            if (typeof contentItem.text === 'string') {\n              const cleaned = contentItem.text\n                .replace(/```json/g, '')\n                .replace(/```/g, '')\n                .trim();\n\n              return JSON.parse(cleaned);\n            }\n          }\n        }\n      }\n    }\n  }\n\n  // Case 3: Other possible OpenAI formats\n  const possibleText =\n    json.text ||\n    json.output_text ||\n    json.response ||\n    json.message?.content ||\n    json.choices?.[0]?.message?.content ||\n    '';\n\n  if (typeof possibleText === 'object' && possibleText !== null) {\n    return possibleText;\n  }\n\n  if (typeof possibleText === 'string' && possibleText.trim()) {\n    const cleaned = possibleText\n      .replace(/```json/g, '')\n      .replace(/```/g, '')\n      .trim();\n\n    return JSON.parse(cleaned);\n  }\n\n  throw new Error('Could not find AI JSON in OpenAI node output');\n}\n\nreturn items.map((item, index) => {\n  let ai;\n\n  try {\n    ai = extractAI(item.json);\n  } catch (error) {\n    ai = {\n      services_offered: '',\n      likely_decision_maker_title: '',\n      why_fit: 'AI parsing failed. Review manually.',\n      likely_pain_point: '',\n      personalized_opening_line: '',\n      suggested_pitch: '',\n      lead_score: 0,\n      recommended_next_step: 'Manual review required',\n      ghl_tags: ['ai-review-needed']\n    };\n  }\n\n  const base = originalLeads[index]?.json || {};\n\n  const leadScore = Number(ai.lead_score || 0);\n  const aiTags = Array.isArray(ai.ghl_tags) ? ai.ghl_tags : [];\n\n  const finalTags = leadScore >= 7\n    ? [...new Set([...fixedQualifiedTags, ...aiTags])]\n    : [...new Set([...fixedReviewTags, ...aiTags])];\n\n  return {\n    json: {\n      ...base,\n\n      'Email': cleanEmail(base['Email']),\n      'Source': 'AI Lead Research - Brandon Apify',\n\n      'Services Offered': ai.services_offered || '',\n      'Decision Maker Title': ai.likely_decision_maker_title || base['Decision Maker Title'] || '',\n      'Why They Are a Fit': ai.why_fit || '',\n      'Pain Point': ai.likely_pain_point || '',\n      'Personalized Opening Line': ai.personalized_opening_line || '',\n      'Suggested Pitch': ai.suggested_pitch || '',\n      'Lead Score': leadScore,\n      'Next Step': ai.recommended_next_step || '',\n      'Status': leadScore >= 7 ? 'Qualified - Push to GHL' : 'Review',\n      'GHL Tags': finalTags.join(','),\n\n      ghl_tags_array: finalTags\n    }\n  };\n});"
      },
