    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/actor-tasks/{{$env.APIFY_ACTOR_TASK_ID}}/run-sync-get-dataset-items?token={{$env.APIFY_TOKEN}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"searchStringsArray\": [\"{{$json.searchQuery}}\"],\n  \"maxCrawledPlacesPerSearch\": {{$json.maxResults}},\n  \"language\": \"en\",\n  \"countryCode\": \"us\",\n  \"includeReviews\": false,\n  \"includeImages\": false,\n  \"includeOpeningHours\": false\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "c6db1dcf-ab69-4943-9344-7df45288b7de",
      "name": "Run Apify Actor - Get Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -3360,
        752
      ],
      "notes": "Uses Apify run-sync-get-dataset-items. Set APIFY_ACTOR_TASK_ID to the selected scraper Actor task and APIFY_TOKEN to the Apify API token (both as n8n environment variables). Actor input fields may need edits depending on the Actor."
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all();\n\nconst searchConfig = $('Set Apify Search').first().json;\nconst maxResults = Number(searchConfig.maxResults || 5);\n\nlet raw = [];\n\nfor (const item of input) {\n  if (Array.isArray(item.json)) {\n    raw.push(...item.json);\n  } else if (Array.isArray(item.json.items)) {\n    raw.push(...item.json.items);\n  } else if (item.json && Object.keys(item.json).length) {\n    raw.push(item.json);\n  }\n}\n\nfunction first(...vals) {\n  return vals.find(v => v !== undefined && v !== null && String(v).trim() !== '') || '';\n}\n\nfunction normalizePhone(phone) {\n  return String(phone || '').replace(/[^0-9+]/g, '');\n}\n\nfunction normalizeWebsite(website) {\n  return String(website || '')\n    .toLowerCase()\n    .replace(/^https?:\\/\\//, '')\n    .replace(/^www\\./, '')\n    .replace(/\\/$/, '')\n    .trim();\n}\n\nfunction makeKey(website, phone, name, city) {\n  const w = normalizeWebsite(website);\n  const p = normalizePhone(phone);\n  const n = String(name || '').toLowerCase().replace(/[^a-z0-9]/g, '').trim();\n  const c = String(city || '').toLowerCase().replace(/[^a-z0-9]/g, '').trim();\n\n  return w || p || `${n}-${c}`;\n}\n\nconst seen = new Set();\nconst output = [];\n\nfor (const lead of raw) {\n  const company = first(\n  lead.organizationName,\n  lead.companyName,\n  lead.company,\n  lead.accountName,\n  lead.placeName,\n  lead.name,\n  lead.title\n);\n\n  const website = first(\n    lead.organizationWebsite,\n    lead.website,\n    lead.url,\n    lead.site\n  );\n\n  const phone = first(\n    lead.phone,\n    lead.phoneUnformatted,\n    lead.phoneNumber,\n    lead.telephone\n  );\n\n  const email = first(\n    lead.email,\n    Array.isArray(lead.emails) ? lead.emails[0] : ''\n  );\n\n  const city = first(\n    lead.city,\n    lead.location?.city\n  );\n\n  const state = first(\n    lead.state,\n    lead.stateRegion,\n    lead.location?.state,\n    lead.region\n  );\n\n  const country = first(\n    lead.country,\n    lead.location?.country,\n    'United States'\n  );\n\n  const address = first(\n    lead.address,\n    lead.street,\n    lead.fullAddress\n  );\n\n  const category = first(\n    lead.categoryName,\n    lead.category,\n    Array.isArray(lead.categories) ? lead.categories[0] : '',\n    lead.industry\n  );\n\n  const mapsUrl = first(\n    lead.googleMapsUrl,\n    lead.placeUrl\n  );\n\n  const rating = first(\n    lead.totalScore,\n    lead.rating,\n    lead.stars\n  );\n\n  const reviews = first(\n    lead.reviewsCount,\n    lead.reviewCount,\n    lead.reviews\n  );\n\n  const decisionMakerName = first(\n    lead.fullName,\n    `${first(lead.firstName)} ${first(lead.lastName)}`.trim()\n  );\n\n  const decisionMakerTitle = first(\n    lead.position,\n    lead.seniority,\n    lead.title\n  );\n\n  const linkedInUrl = first(\n    lead.linkedInUrl,\n    lead.linkedinUrl,\n    lead.linkedin\n  );\n\n  const key = makeKey(website, phone, company, city);\n\n  if (!company || seen.has(key)) {\n    continue;\n  }\n\n  seen.add(key);\n\n  output.push({\n    json: {\n      'Prospect ID': `APIFY-${Date.now()}-${output.length + 1}`,\n      'Company Name': company,\n      'Website': website,\n      'Country': country,\n      'State/Region': state,\n      'Company Size': '',\n      'Target Market': searchConfig.targetMarket || 'Digital Marketing Agency',\n      'Services Offered': '',\n      'Decision Maker Name': decisionMakerName,\n      'Decision Maker Title': decisionMakerTitle,\n      'LinkedIn URL': linkedInUrl,\n      'Email': email,\n      'Phone': phone,\n      'Why They Are a Fit': '',\n      'Pain Point': '',\n      'Personalized Opening Line': '',\n      'Suggested Pitch': '',\n      'Lead Score': '',\n      'Status': 'Ready',\n      'Next Step': '',\n      'GHL Tags': '',\n      'GHL Contact ID': '',\n      'Notes': '',\n      'Source': 'AI Lead Research - Brandon Apify',\n      'Apify Run ID': first(lead.$runId, lead.runId, ''),\n      'Address': address,\n      'City': city,\n      'Category': category,\n      'Google Maps URL': mapsUrl,\n      'Rating': rating,\n      'Reviews Count': reviews,\n      'Duplicate Check Key': key\n    }\n  });\n\n  if (output.length >= maxResults) {\n    break;\n  }\n}\n\nreturn output;"
      },
